# Copy to .env.local. Do not commit real values.
# The Next.js server reads these. The Chrome extension never sees the service role key,
# the Stripe secret, or the AI keys.

# ── Supabase (database + auth stay here) ──────────────────────────────────────
# Project URL, e.g. https://kihuepwhrftjgmglnxnc.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# anon / publishable key. Safe to expose to the browser and the extension.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role key. Server only. Bypasses RLS. Never ship this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── This app ──────────────────────────────────────────────────────────────────
# Public origin of cannediq-web. No trailing slash.
# Production: https://cannediq.com   Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=
# 32-character Chrome extension id (the published one, from the manifest key).
# Used for CORS (chrome-extension://<id>) and "return to extension" links.
CHROME_EXTENSION_ID=
# Optional comma-separated extra browser origins allowed to call /api/*
# CORS_EXTRA_ORIGINS=https://staging.cannediq.com

# ── Stripe ────────────────────────────────────────────────────────────────────
# sk_test_... or sk_live_...
STRIPE_SECRET_KEY=
# Signing secret for the endpoint https://<NEXT_PUBLIC_APP_URL>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Price IDs from the Stripe Dashboard (Products). Required for checkout.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_AI_MONTHLY=
STRIPE_PRICE_TEAM_MONTHLY=
# Optional aliases read by the legacy create-checkout-session route if the
# STRIPE_PRICE_*_MONTHLY vars above are unset.
# STRIPE_PRO_PRICE_ID=
# STRIPE_AI_PRICE_ID=
# STRIPE_TEAM_PRICE_ID=

# ── AI generation (server only) ───────────────────────────────────────────────
# OpenAI is tried first; Gemini is the fallback. At least one must be set.
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Invites, provisioned accounts, and password resets. If unset, the server
# still creates the invite/account and logs the link or temp password.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
